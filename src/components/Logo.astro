<style>
  .logo {
    display: inline-flex;
    align-items: center;
    /* マークは右上→左下の対角形状で右下に余白があるため、
       ギャップを詰めて文字を空白側に寄せている（光学調整） */
    gap: calc(var(--logo-size) * 0.11);
    color: var(--logo-ink);
  }

  .logo__mark {
    width: auto;
    height: var(--logo-size);
  }

  /* キャップハイトがマーク高の約6割になるよう調整。
     viewBox にディセンダ(y の足)を含むため、その分だけ高さを足している */
  .logo__type {
    width: auto;
    height: calc(var(--logo-size) * 0.78);
  }
</style>
