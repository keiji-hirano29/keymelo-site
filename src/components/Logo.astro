---
// Logo.astro - Keymelo ブランドロゴ（マーク＋ロゴタイプ）
// ロゴタイプは Cormorant Garamond Medium(OFL) をアウトライン化した SVG パス。
// フォント読み込みが不要なので、どの環境でも同じ形で表示される。
interface Props {
  /** ロゴマークの高さ(px)。ロゴタイプはこれに追従する */
  size?: number;
  /** 見出しロゴとして使う場合は false（装飾のときは alt/aria を消す） */
  decorative?: boolean;
}

const { size = 36, decorative = false } = Astro.props;
