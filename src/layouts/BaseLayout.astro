---
// BaseLayout.astro - 全ページ共通レイアウト（meta / OGP / ヘッダ / フッタ）
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** OGP画像のパス。ページ固有の画像を出したいときだけ指定する */
  ogImage?: string;
}

const { title, description, ogImage = "/ogp.png" } = Astro.props;

// Astro.site（astro.config.mjs の site）を基準に絶対URLを組み立てる
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keymelo Systems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />

    {/*
      fade-in の初期状態（opacity:0）は .js が付いているときだけ効く。
      Astro の <script> は module = defer 相当で最初のペイント後に走るため、
      ここで同期実行して「見えてから消える」チラつきを防いでいる。
      IntersectionObserver が無い環境では .js を付けない＝最初から見える。
    */}
    <script is:inline>
      if ("IntersectionObserver" in window) {
        document.documentElement.classList.add("js");
      }
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>

    <Header path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // .js は head の同期スクリプトで付与済み。ここでは監視を仕掛けるだけ。
      // 途中で例外が出るとコンテンツが透明のまま残るため、必ず握って復帰させる。
      const showAll = () => {
        document
          .querySelectorAll(".fade-in")
          .forEach((el) => el.classList.add("is-visible"));
      };

      try {
        const targets = document.querySelectorAll(".fade-in");

        if (
          targets.length > 0 &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          showAll();
        } else if (targets.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
          );

          targets.forEach((el) => observer.observe(el));
        }
      } catch {
        // .js を外して初期状態の opacity:0 自体を無効化してから全表示する
        document.documentElement.classList.remove("js");
        showAll();
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--gutter);
        z-index: 200;
        padding: 10px 20px;
        background: var(--brand);
        color: #ffffff;
        border-radius: var(--radius-pill);
        font-size: var(--text-caption);
        text-decoration: none;
        transition: top 0.2s var(--ease);
      }

      .skip-link:focus {
        top: 12px;
        color: #ffffff;
        text-decoration: none;
      }
    </style>
  </body>
</html>
